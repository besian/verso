rules_version = '2';

// Profiles, handles, books and follows are public to read (Explore and artist
// profiles work signed out); only the owner can change their own data.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    function str(v, max) { return v is string && v.size() <= max; }
    // Moderators: an admins/{uid} document added by hand in the Firebase console.
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function suspended() { return signedIn() && exists(/databases/$(database)/documents/banned/$(request.auth.uid)); }
    // Fletora Plus: plus/{uid}, written only by api/stripe-webhook. `until` already includes a few days' grace.
    // `until` is milliseconds; a number typed in the console as text, or a date, counts too.
    function plus(uid) {
      let p = /databases/$(database)/documents/plus/$(uid);
      let u = exists(p) ? get(p).data.get('until', 0) : 0;
      return exists(p) && get(p).data.get('on', false) == true
        && (((u is int || u is float) && u > request.time.toMillis())
          || (u is string && u.matches('^[0-9]{10,16}$') && int(u) > request.time.toMillis())
          || (u is timestamp && u > request.time));
    }

    // Social links on a profile: known platforms only, one handle (≤ 100 characters) each.
    function sv(s, k) { return !(k in s) || str(s[k], 100); }
    function socialsOk(s) {
      return s is map && s.keys().hasOnly(['instagram', 'tiktok', 'x', 'threads', 'bluesky', 'youtube', 'pinterest', 'behance', 'dribbble', 'artstation', 'deviantart', 'patreon', 'kofi', 'etsy', 'linkedin'])
        && sv(s, 'instagram') && sv(s, 'tiktok') && sv(s, 'x') && sv(s, 'threads') && sv(s, 'bluesky')
        && sv(s, 'youtube') && sv(s, 'pinterest') && sv(s, 'behance') && sv(s, 'dribbble') && sv(s, 'artstation')
        && sv(s, 'deviantart') && sv(s, 'patreon') && sv(s, 'kofi') && sv(s, 'etsy') && sv(s, 'linkedin');
    }

    match /users/{uid} {
      allow read: if true;
      // The handle must be reserved by this user in the same write (see handles below).
      allow create, update: if isUser(uid)
        && request.resource.data.keys().hasOnly(['name', 'handle', 'bio', 'loc', 'web', 'ig', 'mail', 'socials', 'accent', 'av', 'joined', 'pin'])
        && str(request.resource.data.name, 80)
        && str(request.resource.data.bio, 160)
        && str(request.resource.data.loc, 80)
        && str(request.resource.data.web, 200)
        && (!('ig' in request.resource.data) || str(request.resource.data.ig, 40))
        && (!('mail' in request.resource.data) || str(request.resource.data.mail, 120))
        && (!('socials' in request.resource.data) || socialsOk(request.resource.data.socials))
        // A pinned sketchbook (Plus): choosing or changing it needs Plus; keeping or clearing it doesn't.
        && (!('pin' in request.resource.data) || (str(request.resource.data.pin, 40) && (request.resource.data.pin == ''
          || (resource != null && resource.data.get('pin', '') == request.resource.data.pin) || plus(uid))))
        && getAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle)).data.uid == uid;
      // Account deletion removes the profile along with everything else.
      allow delete: if isUser(uid);

      match /following/{target} {
        allow read: if true;
        allow write: if isUser(uid) && target != uid;
      }
      // One entry per follower, written by the follower; its size is the follower count.
      // The profile owner can also remove entries (account deletion).
      match /followers/{fid} {
        allow read: if true;
        allow create, update: if isUser(fid) && fid != uid;
        allow delete: if isUser(fid) || isUser(uid);
      }
      // Saved sketchbooks and blocked artists are private to their owner.
      match /saved/{bookId} {
        allow read, write: if isUser(uid);
      }
      match /blocked/{target} {
        allow read: if isUser(uid);
        allow write: if isUser(uid) && target != uid;
      }
      // Notifications: written by whoever liked/followed (or by you, for reaching a goal); only you read them.
      // Ids are fixed per person and action (like_<book>_<uid>, follow_<uid>, goal_<goal>) and can't be
      // overwritten, so liking and unliking over and over sends one notification, not hundreds.
      match /notifications/{nid} {
        allow read, delete: if isUser(uid);
        allow update: if isUser(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create: if signedIn() && !suspended()
          && request.resource.data.from == request.auth.uid
          && request.resource.data.read == false
          && request.resource.data.keys().hasOnly(['type', 'from', 'fromName', 'fromHandle', 'bookId', 'bookName', 'goal', 'at', 'read', 'commentId', 'text', 'page', 'replyTo'])
          && ((request.resource.data.type in ['like', 'invite'] && nid == request.resource.data.type + '_' + request.resource.data.bookId + '_' + request.auth.uid)
            // A comment: one notification per comment, sent with it, by its author, to the book's owner.
            || (request.resource.data.type == 'comment' && nid == 'comment_' + request.resource.data.commentId && str(request.resource.data.text, 140)
              && getAfter(/databases/$(database)/documents/books/$(request.resource.data.bookId)/comments/$(request.resource.data.commentId)).data.uid == request.auth.uid
              && get(/databases/$(database)/documents/books/$(request.resource.data.bookId)).data.ownerId == uid)
            // A like on a comment: once per person per comment, to the comment's author, in the same write as the like.
            || (request.resource.data.type == 'commentLike' && nid == 'clike_' + request.resource.data.commentId + '_' + request.auth.uid && str(request.resource.data.text, 140)
              && getAfter(/databases/$(database)/documents/books/$(request.resource.data.bookId)/comments/$(request.resource.data.commentId)).data.uid == uid
              && request.auth.uid in getAfter(/databases/$(database)/documents/books/$(request.resource.data.bookId)/comments/$(request.resource.data.commentId)).data.get('likes', []))
            // A reply: to the author of the comment it answers, sent with the reply by its author.
            || (request.resource.data.type == 'reply' && nid == 'reply_' + request.resource.data.commentId && str(request.resource.data.text, 140)
              && getAfter(/databases/$(database)/documents/books/$(request.resource.data.bookId)/comments/$(request.resource.data.commentId)).data.uid == request.auth.uid
              && getAfter(/databases/$(database)/documents/books/$(request.resource.data.bookId)/comments/$(request.resource.data.commentId)).data.get('replyTo', '') == request.resource.data.replyTo
              && get(/databases/$(database)/documents/books/$(request.resource.data.bookId)/comments/$(request.resource.data.replyTo)).data.uid == uid)
            // A mention: to someone whose @handle is in the comment, sent with it by its author.
            || (request.resource.data.type == 'mention' && nid == 'mention_' + request.resource.data.commentId && str(request.resource.data.text, 140)
              && getAfter(/databases/$(database)/documents/books/$(request.resource.data.bookId)/comments/$(request.resource.data.commentId)).data.uid == request.auth.uid
              && getAfter(/databases/$(database)/documents/books/$(request.resource.data.bookId)/comments/$(request.resource.data.commentId)).data.text.lower().matches('(?s).*@' + get(/databases/$(database)/documents/users/$(uid)).data.handle + '.*'))
            || (request.resource.data.type == 'follow' && nid == 'follow_' + request.auth.uid)
            || (request.resource.data.type == 'goal' && uid == request.auth.uid && nid == 'goal_' + request.resource.data.goal));
      }
    }

    // Like and follower counts. Anyone signed in may move a count by exactly one, and only in the
    // same write that adds or removes their own like/follow, so counts can't be inflated.
    function prev(f) { return resource == null ? 0 : resource.data.get(f, 0); }
    function next(f) { return request.resource.data.get(f, 0); }
    function changedBy(f, d) { return next(f) == prev(f) + d; }
    function added(p) { return !exists(p) && existsAfter(p); }
    function removed(p) { return exists(p) && !existsAfter(p); }

    match /userCounts/{uid} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['followers', 'likes', 'likeBook'])
        && (followDelta(uid) || likeDelta(uid));
      function followDelta(uid) {
        let p = /databases/$(database)/documents/users/$(request.auth.uid)/following/$(uid);
        return changedBy('likes', 0) && ((changedBy('followers', 1) && added(p)) || (changedBy('followers', -1) && removed(p)));
      }
      function likeDelta(uid) {
        let b = request.resource.data.likeBook;
        let p = /databases/$(database)/documents/books/$(b)/likes/$(request.auth.uid);
        return changedBy('followers', 0) && getAfter(/databases/$(database)/documents/books/$(b)).data.ownerId == uid
          && ((changedBy('likes', 1) && added(p)) || (changedBy('likes', -1) && removed(p)));
      }
    }

    match /bookCounts/{bookId} {
      allow read: if true;
      allow create, update: if signedIn() && request.resource.data.keys().hasOnly(['likes']) && likeDelta(bookId);
      function likeDelta(bookId) {
        let p = /databases/$(database)/documents/books/$(bookId)/likes/$(request.auth.uid);
        return (changedBy('likes', 1) && added(p)) || (changedBy('likes', -1) && removed(p));
      }
    }

    // Written only by the upload check (api/image): sketchbooks it has labelled Mature, and its daily counts.
    // Moderators remove a marker when they take the label off.
    match /mature/{bookId} {
      allow read, delete: if isAdmin();
    }
    match /checkLog/{id} {
      allow read, write: if false;
    }

    // Reports: one per person per sketchbook or artist (id <reporter>_<target>), read and cleared by moderators.
    // The upload check adds its own (id check_…, kind 'image' for pictures it held back).
    match /reports/{id} {
      allow create: if signedIn()
        && id == request.auth.uid + '_' + request.resource.data.targetId
        && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['by', 'kind', 'targetId', 'ownerId', 'reason', 'note', 'at'])
        && request.resource.data.kind in ['book', 'user', 'message', 'comment']
        && str(request.resource.data.reason, 60) && str(request.resource.data.note, 500);
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // ---------- messages ----------
    // A conversation between two people: chats/{a}_{b} (uids in order). Only its two members can read it or its
    // messages. Someone who follows you can start one with you directly ('open'); anyone else's first message
    // arrives as a request, which only you can accept or decline, and you can't reply until you accept.
    // Nobody you've blocked can message you, suspended accounts can't send, and starting conversations is
    // limited to 20 a day per person (chatLimits, counted in the same write).
    function today() { return math.floor(request.time.toMillis() / 86400000); }
    function otherOf(m) { return m[0] == request.auth.uid ? m[1] : m[0]; }
    function blockedBy(u) { return exists(/databases/$(database)/documents/users/$(u)/blocked/$(request.auth.uid)); }
    match /chatLimits/{uid} {
      allow read: if isUser(uid);
      allow create, update: if isUser(uid) && request.resource.data.keys().hasOnly(['day', 'n'])
        && request.resource.data.day == today() && request.resource.data.n <= 20
        && request.resource.data.n == (resource == null || resource.data.day != today() ? 1 : resource.data.n + 1);
    }
    match /chats/{id} {
      function lim() { return /databases/$(database)/documents/chatLimits/$(request.auth.uid); }
      function counted() { return existsAfter(lim()) && (!exists(lim()) || getAfter(lim()).data != get(lim()).data); }
      function lastIsMine(d) { return d.lastFrom == request.auth.uid && d.lastAt == request.time && str(d.lastText, 140); }
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && !suspended()
        && request.resource.data.keys().hasOnly(['members', 'info', 'by', 'status', 'lastText', 'lastFrom', 'lastAt', 'read'])
        && request.resource.data.members is list && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && id == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.resource.data.by == request.auth.uid && lastIsMine(request.resource.data)
        && (request.resource.data.status == 'request' || (request.resource.data.status == 'open'
          && exists(/databases/$(database)/documents/users/$(otherOf(request.resource.data.members))/following/$(request.auth.uid))))
        && !blockedBy(otherOf(request.resource.data.members)) && counted();
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastText', 'lastFrom', 'lastAt', 'read', 'status'])
        // Only the person asked accepts or declines (and may accept a request they declined earlier).
        && (request.resource.data.status == resource.data.status
          || (resource.data.by != request.auth.uid && resource.data.status in ['request', 'declined'] && request.resource.data.status in ['open', 'declined']))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastText', 'lastFrom', 'lastAt']) || lastIsMine(request.resource.data))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['read'])
          || request.resource.data.read.diff(resource.data.read).affectedKeys().hasOnly([request.auth.uid]));
      allow delete: if false;
      match /messages/{mid} {
        function chat() { return getAfter(/databases/$(database)/documents/chats/$(id)).data; }
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(id)).data.members;
        allow create: if signedIn() && !suspended()
          && request.resource.data.keys().hasOnly(['from', 'text', 'at'])
          && request.resource.data.from == request.auth.uid && request.resource.data.at == request.time
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.auth.uid in chat().members && (chat().status == 'open' || chat().by == request.auth.uid)
          && !blockedBy(otherOf(chat().members));
        allow update, delete: if false;
      }
    }

    // Moderators (the Fletora team). Public, so their accounts can show a verified tick.
    match /admins/{uid} {
      allow read: if true;
      allow write: if false;
    }
    // Suspended artists can't publish sketchbooks or send notifications.
    match /banned/{uid} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // From the archive: historical, public-domain sketchbooks moderators feature on Explore, with the artist,
    // years and source credited (archive/{bookId}). Anyone can read; only moderators add or change them.
    match /archive/{bookId} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['artist', 'years', 'source', 'url', 'note', 'by', 'at'])
        && str(request.resource.data.artist, 80) && str(request.resource.data.years, 40) && str(request.resource.data.source, 80)
        && str(request.resource.data.url, 300) && str(request.resource.data.note, 600);
      allow delete: if isAdmin();
    }

    // Plus status is public (the Plus mark); the plan details in billing are the owner's alone. Only the
    // server writes either.
    match /plus/{uid} {
      allow read: if true;
      allow write: if false;
    }
    // Email settings (the weekly email is opt-in). The server also writes lastWeekly and turns it off on unsubscribe.
    match /emailPrefs/{uid} {
      allow read: if isUser(uid);
      allow create, update: if isUser(uid) && request.resource.data.keys().hasOnly(['weekly', 'at', 'lastWeekly'])
        && request.resource.data.weekly is bool && request.resource.data.at is int
        && request.resource.data.get('lastWeekly', 0) == (resource == null ? 0 : resource.data.get('lastWeekly', 0));
      allow delete: if isUser(uid);
    }
    match /billing/{uid} {
      allow read: if isUser(uid);
      allow write: if false;
    }

    // Stats for a sketchbook, read by its owner (Plus shows them). Anyone may count a view, one at a time and
    // with where it came from; saves move by one only in the same write as the saver's own saved entry.
    match /stats/{bookId} {
      function was(k) { return resource == null ? 0 : resource.data.get(k, 0); }
      function step(k, d) { return request.resource.data.get(k, 0) == was(k) + d; }
      function changed() { return request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys(); }
      function src(k) { return step(k, 0) || step(k, 1); }
      function viewed() {
        return changed().size() == 2 && step('views', 1) && step('saves', 0)
          && src('explore') && src('profile') && src('home') && src('link') && src('embed');
      }
      function saved() {
        let p = /databases/$(database)/documents/users/$(request.auth.uid)/saved/$(bookId);
        return signedIn() && changed().hasOnly(['saves']) && request.resource.data.get('saves', 0) >= 0
          && ((step('saves', 1) && added(p)) || (step('saves', -1) && removed(p)));
      }
      allow read: if signedIn() && (get(/databases/$(database)/documents/books/$(bookId)).data.ownerId == request.auth.uid || isAdmin());
      allow create, update: if request.resource.data.keys().hasOnly(['views', 'explore', 'profile', 'home', 'link', 'embed', 'saves']) && (viewed() || saved());
    }

    // Staff pick: the sketchbook moderators feature on the home page.
    match /picks/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Stroke replays of pages drawn in Fletora: replays/{bookId}_{page} says one exists (and who drew it), and
    // replayData holds the strokes. Readable by anyone who can open the book; written by its owner or the people
    // drawing in it; deleted by its owner.
    function bookCanOpen(bid) {
      let b = get(/databases/$(database)/documents/books/$(bid)).data;
      return b.get('isPublic', true) == true || (b.get('linkOnly', false) == true && b.get('hidden', false) == false)
        || (signedIn() && (b.ownerId == request.auth.uid || request.auth.uid in b.get('collabs', []))) || isAdmin();
    }
    function bookCanDraw(bid) {
      let b = get(/databases/$(database)/documents/books/$(bid)).data;
      return signedIn() && !suspended() && (b.ownerId == request.auth.uid || request.auth.uid in b.get('collabs', []));
    }
    match /replays/{id} {
      allow get: if bookCanOpen(resource.data.bookId);
      allow create, update: if request.resource.data.keys().hasOnly(['bookId', 'page', 'by', 'n', 'at'])
        && id == request.resource.data.bookId + '_' + request.resource.data.page && request.resource.data.by == request.auth.uid
        && str(request.resource.data.page, 40) && bookCanDraw(request.resource.data.bookId);
      allow delete: if signedIn() && (resource.data.by == request.auth.uid
        || get(/databases/$(database)/documents/books/$(resource.data.bookId)).data.ownerId == request.auth.uid);
    }
    match /replayData/{id} {
      allow get: if bookCanOpen(resource.data.bookId);
      allow create, update: if request.resource.data.keys().hasOnly(['bookId', 'by', 'data'])
        && id.matches('^' + request.resource.data.bookId + '_.+') && request.resource.data.by == request.auth.uid
        && str(request.resource.data.data, 900000) && bookCanDraw(request.resource.data.bookId);
      allow delete: if signedIn() && (resource.data.by == request.auth.uid
        || get(/databases/$(database)/documents/books/$(resource.data.bookId)).data.ownerId == request.auth.uid);
    }

    // One document per handle so handles stay unique.
    match /handles/{handle} {
      allow read: if true;
      allow create: if signedIn()
        && handle.matches('^[a-z0-9._]{1,24}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /books/{bookId} {
      function valid(d) {
        return d.keys().hasOnly(['ownerId', 'ownerName', 'ownerHandle', 'name', 'color', 'shape', 'cover', 'pages', 'pageCount', 'createdAt', 'updatedAt', 'isPublic', 'linkOnly', 'thumbs', 'coverThumb',
            'captions', 'dates', 'mediums', 'tags', 'labels', 'hidden', 'collab', 'collabName', 'collabHandle', 'invite', 'inviteName', 'inviteHandle',
            'collabs', 'invites', 'people', 'mature', 'matureLock', 'spreads', 'fillers'])
          && (!('isPublic' in d) || d.isPublic is bool)
          && (!('thumbs' in d) || (d.thumbs is list && d.thumbs.size() <= 1000))
          && (!('captions' in d) || (d.captions is list && d.captions.size() <= 1000))
          && (!('dates' in d) || (d.dates is list && d.dates.size() <= 1000))
          && (!('spreads' in d) || (d.spreads is list && d.spreads.size() <= 1000))
          && (!('fillers' in d) || (d.fillers is list && d.fillers.size() <= 1000))
          && (!('mediums' in d) || (d.mediums is list && d.mediums.size() <= 4))
          && (!('tags' in d) || (d.tags is list && d.tags.size() <= 8))
          && (!('labels' in d) || (d.labels is list && d.labels.size() <= 12))
          && str(d.name, 120)
          && d.shape in ['pocket', 'portrait', 'square', 'landscape', 'panorama']
          && d.pages is list && d.pageCount == d.pages.size() && pagesOk(d)
          && linkOk(d)
          // Suspended artists can only keep private sketchbooks.
          && ((d.get('isPublic', true) == false && d.get('linkOnly', false) == false) || !suspended());
      }
      // Free sketchbooks hold 60 pages, Plus ones 300 (the owner's plan counts). A book already over the limit
      // can still be reordered and trimmed, just not grow.
      function pagesOk(d) {
        return d.pages.size() <= (plus(d.ownerId) ? 300 : 60) || (resource != null && d.pages.size() <= resource.data.get('pages', []).size());
      }
      // Link-only (Plus): not public, not hidden by moderators; turning it on needs Plus.
      function linkOk(d) {
        let on = d.get('linkOnly', false);
        return on is bool && (on == false || (d.get('isPublic', true) == false && d.get('hidden', false) == false
          && ((resource != null && resource.data.get('linkOnly', false) == true) || plus(d.ownerId))));
      }
      // Mature (drawn nudity or sexual content): the owner can label a book themselves. Once the upload check has
      // labelled it (matureLock on the book, or a marker in mature/ for a book not saved yet), it stays labelled;
      // only moderators take it off.
      // Checked on the owner's saves only: people drawing in a book can't touch these fields (collabEdits).
      function matureOk() {
        let m = request.resource.data.get('mature', false);
        let lock = request.resource.data.get('matureLock', false);
        return m is bool && lock is bool && (lock == false || m == true)
          && (lock == true || resource == null || resource.data.get('matureLock', false) == false)
          && (m == true || !exists(/databases/$(database)/documents/mature/$(bookId)));
      }
      // Only moderators set `hidden`; a hidden book stays private until they restore it.
      function keepsHidden() {
        let was = resource.data.get('hidden', false);
        return request.resource.data.get('hidden', false) == was && (was == false || (request.resource.data.isPublic == false && request.resource.data.get('linkOnly', false) == false));
      }
      // Sharing: people in `collabs` can add pages; the owner invites people (`invites`, with names in `people`) and
      // they accept. One person on the free plan, five with Plus. Books shared before there could be several people
      // keep one `collab` / `invite` until their sharing next changes, which moves them to the lists.
      function was(k) { return resource.data.get(k, null); }
      function now(k) { return request.resource.data.get(k, null); }
      function changes() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function me() { return signedIn() ? request.auth.uid : ''; }
      function oldCollabs() { return resource.data.get('collabs', []).concat(was('collab') == null ? [] : [was('collab')]); }
      function oldInvites() { return resource.data.get('invites', []).concat(was('invite') == null ? [] : [was('invite')]); }
      function newCollabs() { return request.resource.data.get('collabs', []); }
      function newInvites() { return request.resource.data.get('invites', []); }
      function shareFields() { return ['collab', 'collabName', 'collabHandle', 'invite', 'inviteName', 'inviteHandle', 'collabs', 'invites', 'people']; }
      // Any change to sharing writes the lists (clearing the older single fields), with names only for people in it.
      function shareShape() {
        return now('collab') == null && now('invite') == null && newCollabs() is list && newInvites() is list
          && newCollabs().size() <= 5 && newInvites().size() <= 5
          && (!('people' in request.resource.data) || (request.resource.data.people is map
            && request.resource.data.people.keys().hasOnly(newCollabs().concat(newInvites()))));
      }
      // The owner may invite people up to their plan's limit, cancel invitations and remove people, but never add
      // someone directly. Over the limit (Plus ended), they can still remove people, just not invite more.
      function ownerShares() {
        return !changes().hasAny(shareFields()) || (shareShape()
          && newCollabs().hasOnly(oldCollabs())
          && !(resource.data.ownerId in newInvites()) && !(resource.data.ownerId in newCollabs())
          && (newInvites().hasOnly(oldInvites()) || newCollabs().size() + newInvites().size() <= (plus(resource.data.ownerId) ? 5 : 1)));
      }
      function collabEdits() {
        return me() in oldCollabs() && changes().hasOnly(['pages', 'pageCount', 'thumbs', 'captions', 'dates', 'spreads', 'fillers', 'updatedAt']) && valid(request.resource.data);
      }
      // Someone invited accepts (moving into collabs) or declines; someone drawing in it leaves.
      function inviteeAnswers() {
        return me() in oldInvites() && changes().hasOnly(shareFields()) && shareShape()
          && newInvites().toSet() == oldInvites().toSet().difference([me()].toSet())
          && (newCollabs().toSet() == oldCollabs().toSet() || newCollabs().toSet() == oldCollabs().toSet().union([me()].toSet()));
      }
      function collabLeaves() {
        return me() in oldCollabs() && changes().hasOnly(shareFields()) && shareShape()
          && newCollabs().toSet() == oldCollabs().toSet().difference([me()].toSet()) && newInvites().toSet() == oldInvites().toSet();
      }

      // Private books are readable only by their owner, the person they're shared with or invited to (and moderators).
      // A link-only book opens for anyone with its address, but never shows up in a list (Explore, profiles).
      function readable() {
        return resource.data.get('isPublic', true) == true || (signedIn() && resource.data.ownerId == request.auth.uid)
          || (signedIn() && resource.data.get('collab', null) == request.auth.uid) || (signedIn() && resource.data.get('invite', null) == request.auth.uid)
          || (signedIn() && request.auth.uid in resource.data.get('collabs', [])) || (signedIn() && request.auth.uid in resource.data.get('invites', [])) || isAdmin();
      }
      allow get: if readable() || (resource.data.get('linkOnly', false) == true && resource.data.get('hidden', false) == false);
      // Lists read isPublic directly: a default (get('isPublic', true)) lets a query match private books.
      allow list: if resource.data.isPublic == true || (signedIn() && resource.data.ownerId == request.auth.uid)
        || (signedIn() && resource.data.collab == request.auth.uid) || (signedIn() && resource.data.invite == request.auth.uid)
        || (signedIn() && request.auth.uid in resource.data.collabs) || (signedIn() && request.auth.uid in resource.data.invites) || isAdmin();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid && valid(request.resource.data) && matureOk()
        && request.resource.data.get('hidden', false) == false && now('collab') == null && now('invite') == null
        && newCollabs().size() == 0 && newInvites().size() == 0;
      allow update: if (signedIn() && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId && valid(request.resource.data) && keepsHidden() && ownerShares() && matureOk())
        || (signedIn() && (collabEdits() || inviteeAnswers() || collabLeaves()))
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPublic', 'hidden', 'linkOnly', 'mature', 'matureLock']));
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      // One like per person per book; anyone can see who liked it.
      match /likes/{likerId} {
        allow read: if true;
        allow create, delete: if signedIn() && likerId == request.auth.uid;
      }

      // Comments on a page (`page` is a short code for the page's picture). Anyone who can open the book reads them;
      // signed-in people post as themselves, unless suspended or blocked by the book's owner. Nobody edits a
      // comment; its author, the book's owner and moderators can delete it.
      function bookDoc() { return get(/databases/$(database)/documents/books/$(bookId)).data; }
      function bookOpen(b) {
        return b.get('isPublic', true) == true || (b.get('linkOnly', false) == true && b.get('hidden', false) == false)
          || (signedIn() && (b.ownerId == request.auth.uid || request.auth.uid in b.get('collabs', []))) || isAdmin();
      }
      match /comments/{cid} {
        allow read: if bookOpen(bookDoc());
        allow create: if signedIn() && !suspended() && bookOpen(bookDoc())
          && request.resource.data.keys().hasOnly(['uid', 'name', 'handle', 'page', 'text', 'at', 'replyTo'])
          && (!('replyTo' in request.resource.data) || str(request.resource.data.replyTo, 40))
          && request.resource.data.uid == request.auth.uid
          && str(request.resource.data.name, 80) && str(request.resource.data.handle, 40)
          && str(request.resource.data.page, 40) && request.resource.data.page.size() > 0
          && str(request.resource.data.text, 500) && request.resource.data.text.size() > 0
          && request.resource.data.at is int
          && !exists(/databases/$(database)/documents/users/$(bookDoc().ownerId)/blocked/$(request.auth.uid));
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || bookDoc().ownerId == request.auth.uid || isAdmin());
        // Likes: `likes` lists who liked it; each person adds or takes away only themselves.
        allow update: if signedIn() && !suspended() && bookOpen(bookDoc())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          && request.resource.data.likes is list && request.resource.data.likes.size() <= 5000
          && ((!(request.auth.uid in resource.data.get('likes', []))
              && request.resource.data.likes.toSet() == resource.data.get('likes', []).toSet().union([request.auth.uid].toSet()))
            || ((request.auth.uid in resource.data.get('likes', []))
              && request.resource.data.likes.toSet() == resource.data.get('likes', []).toSet().difference([request.auth.uid].toSet())));
      }
    }
  }
}
