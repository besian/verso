{
  "name": "fletora",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "emulators": "npx -y firebase-tools@15 emulators:start --only auth,firestore,storage --project demo-verso",
    "dev:emulators": "VITE_FIREBASE_EMULATORS=1 VITE_FIREBASE_API_KEY=demo VITE_FIREBASE_PROJECT_ID=demo-verso VITE_FIREBASE_STORAGE_BUCKET=demo-verso.appspot.com VITE_FIREBASE_AUTH_DOMAIN=localhost vite",
    "deploy:rules": "npx -y firebase-tools@15 deploy --only firestore:rules,storage --project verso-57469"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@stripe/stripe-js": "10.0.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": "22.x"
  }
}
