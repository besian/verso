# Firebase web app config: Firebase console → Project settings → General → Your apps → Web app.
# Copy to .env.local for local dev, and add the same variables in Vercel → Project → Settings → Environment Variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to 1 to use the local emulators started by `npm run emulators` instead.
# VITE_FIREBASE_EMULATORS=1
